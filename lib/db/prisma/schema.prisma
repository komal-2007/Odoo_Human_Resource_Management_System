generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  loginId      String          @unique
  passwordHash String
  mustChangePassword Boolean   @default(true)
  role         UserRole        @default(EMPLOYEE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  employee     EmployeeProfile?
  approvedLeaves LeaveRequest[] @relation("LeaveApprover")
}

model EmployeeProfile {
  id             String           @id @default(uuid())
  userId         String           @unique
  employeeCode   String           @unique
  firstName      String
  lastName       String
  phone          String?
  department     String?
  jobTitle       String?
  dateOfJoining  DateTime?
  joiningYear    Int?
  joiningSerial  Int?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance     AttendanceRecord[]
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@unique([joiningYear, joiningSerial])
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  employeeId   String
  workDate     DateTime         @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  status       AttendanceStatus @default(PRESENT)
  employee     EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@unique([employeeId, workDate])
  @@index([workDate])
}

model LeaveRequest {
  id           String          @id @default(uuid())
  employeeId   String
  startDate    DateTime        @db.Date
  endDate      DateTime        @db.Date
  reason       String
  status       LeaveStatus     @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedBy   User?           @relation("LeaveApprover", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  @@index([employeeId, status])
}

model PayrollRecord {
  id             String          @id @default(uuid())
  employeeId     String
  payPeriodStart DateTime        @db.Date
  payPeriodEnd   DateTime        @db.Date
  basicSalary    Decimal         @db.Decimal(12, 2)
  grossSalary    Decimal         @db.Decimal(12, 2)
  deductions     Decimal         @db.Decimal(12, 2)
  netSalary      Decimal         @db.Decimal(12, 2)
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components     SalaryComponent[]
  createdAt      DateTime        @default(now())
  @@unique([employeeId, payPeriodStart, payPeriodEnd])
}

model SalaryComponent {
  id        String        @id @default(uuid())
  payrollId String
  name      String
  type      String
  amount    Decimal       @db.Decimal(12, 2)
  payroll   PayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade)
}